<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net452</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>QuadroControl.Virtuell</RootNamespace>
    <AssemblyName>QuadroControl.Virtuell</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenz-Assemblys: ermoeglichen net452-Build auch unter Linux (EnableWindowsTargeting) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kurs-DLLs: bewusst nicht im Repo (VORLAGE-DLLS.md) -->
    <Reference Include="CRC">
      <HintPath>libs\CRC.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SerialPort">
      <HintPath>libs\SerialPort.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="vKTCQuadroControl">
      <HintPath>libs\vKTCQuadroControl.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Logikkern (UAVTalk, Zustandsmaschine, Sicherheitslogik): net452-Build von QuadroControl.Core -->
    <ProjectReference Include="..\QuadroControl.Core\QuadroControl.Core.csproj" SetTargetFramework="TargetFramework=net452" />
  </ItemGroup>

  <!-- LED-Bilder der Arming-Anzeige (PROG-010A); Quelle: Vorlage_VS.zip bin/Debug, siehe VORLAGE-DLLS.md -->
  <ItemGroup>
    <Resource Include="libs\LED_aus.png" />
    <Resource Include="libs\LED_grn.png" />
  </ItemGroup>

</Project>
